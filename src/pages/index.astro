---
import Full from '../layouts/Full.astro';
---

<Full>
	<div class="folio">
		<header class="topbar">
			<a class="wordmark" href="/">
				komizo
			</a>
			<nav aria-label="Main">
				<a href="#workflow">Workflow</a>
				<a href="https://github.com/nicodes/komizo#readme">Docs ↗</a>
			</nav>
		</header>
		<main id="main-content">
			<section class="host-cover">
				<div class="host-title">
					<p class="tag">OPERATE YOUR OWN COMPOSE HOSTS</p>
					<h1>
						A clear view.
						<br />
						<em>A steady hand.</em>
					</h1>
					<p>
						Prepare hosts, deploy app-scoped Compose stacks, and inspect what’s running. Over SSH. On servers you own.
					</p>
					<div class="host-actions">
						<a class="cta" href="https://github.com/nicodes/komizo#readme">
							Start with Komizo ↗
						</a>
						<span>CLI + LOCAL UI / NO HOSTED ACCOUNT</span>
					</div>
				</div>
				<div class="topology">
					<div class="topology-title">
						<span>HOST OPERATIONS / ILLUSTRATIVE TOPOLOGY</span>
						<span>↗</span>
					</div>
					<div class="operator">
						<span class="node-icon">⌘</span>
						<div>
							<strong>Your workstation</strong>
							<small>komizo CLI · local UI · deployment actions</small>
						</div>
					</div>
					<div class="ssh-link">
						<i></i>
						<span>SSH</span>
						<i></i>
					</div>
					<div class="host-box">
						<div class="host-box-title">
							<span class="node-icon">▤</span>
							<div>
								<strong>Your Compose host</strong>
								<small>App-scoped deployments</small>
							</div>
						</div>
						<div class="app-nodes">
							<div>
								<span>01</span>
								<b>web</b>
								<small>COMPOSE APP</small>
							</div>
							<div>
								<span>02</span>
								<b>api</b>
								<small>COMPOSE APP</small>
							</div>
							<div>
								<span>03</span>
								<b>worker</b>
								<small>COMPOSE APP</small>
							</div>
						</div>
						<div class="host-signals">
							<span>APPLICATIONS</span>
							<span>REPORTS</span>
							<span>LOGS</span>
						</div>
					</div>
					<div class="topology-caption">Keep the deployment and the day-to-day operations in one tool.</div>
				</div>
			</section>
			<section class="operations" id="workflow">
				<div>
					<p class="tag">THE WORK, END TO END</p>
					<h2 class="section-heading">
						Give every app
						<br />a place to run.
					</h2>
					<p>From the first host setup to the next release, keep the work close to your infrastructure.</p>
				</div>
				<div class="operation-list">
					<article>
						<span>01</span>
						<div>
							<h3>Prepare the host</h3>
							<p>
								<code>komizo init</code> sets up a host you administer. Review the documented provisioning changes
								before using it on an existing server.
							</p>
						</div>
					</article>
					<article>
						<span>02</span>
						<div>
							<h3>Deploy one application</h3>
							<p>
								App-scoped Compose is the supported model. Connect releases to your hosts with the companion GitHub
								Actions.
							</p>
							<a href="https://github.com/nicodes/komizo-actions">Deployment actions ↗</a>
						</div>
					</article>
					<article>
						<span>03</span>
						<div>
							<h3>Keep the system in view</h3>
							<p>
								Inspect applications with <code>list</code>, read <code>report</code>, and follow <code>logs</code>. Use{' '}
								<code>ui</code> for the local browser interface.
							</p>
						</div>
					</article>
				</div>
			</section>
			<section class="command-rail" aria-label="Command reference">
				<span>YOUR DAILY TOOLS</span>
				<code>komizo list</code>
				<code>komizo report</code>
				<code>komizo logs</code>
				<code>komizo ui</code>
				<p>
					Use <code>--help</code> for current flags.
				</p>
			</section>
			<section class="host-start">
				<div>
					<p class="tag">PUT IT TO WORK</p>
					<h2 class="section-heading">
						Your box.
						<br />
						Your stack. Your call.
					</h2>
				</div>
				<div>
					<a href="https://github.com/nicodes/komizo/releases">
						<b>Get a release</b>
						<span>Linux & macOS · x86_64 & arm64 ↗</span>
					</a>
					<a href="https://github.com/nicodes/komizo#readme">
						<b>Read the operating guide</b>
						<span>Installation, host prep and current commands ↗</span>
					</a>
					<a href="https://github.com/nicodes/komizo-actions">
						<b>Connect your releases</b>
						<span>GitHub Actions for app deployments ↗</span>
					</a>
				</div>
			</section>
		</main>
		<footer class="bottom">
			<span>komizo / your infrastructure</span>
			<nav aria-label="Footer">
				<a href="https://github.com/nicodes/komizo">Source</a>
				<a href="https://github.com/nicodes/komizo/releases">Releases</a>
			</nav>
		</footer>
	</div>
</Full>
<style>
	* {
		box-sizing: border-box;
	}
	a {
		color: inherit;
		text-underline-offset: 5px;
	}
	img {
		max-width: 100%;
	}
	svg {
		max-width: 100%;
	}
	h1,
	h2,
	h3,
	p {
		overflow-wrap: break-word;
	}
	h1,
	h2,
	h3 {
		text-wrap: balance;
	}
	p {
		line-height: 1.7;
	}
	code,
	pre {
		font-family: var(--mono);
	}
	pre {
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	.folio {
		width: min(1200px, calc(100% - 64px));
		margin: auto;
	}
	.topbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 24px;
		min-height: 100px;
	}
	.wordmark {
		font-size: 23px;
		font-weight: 750;
		letter-spacing: -0.04em;
		text-decoration: none;
	}
	.topbar nav {
		display: flex;
		gap: 25px;
		align-items: center;
		font-size: 12px;
	}
	.topbar nav a {
		text-decoration: none;
	}
	.tag {
		font: 11px var(--mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.cta {
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		gap: 30px;
		padding: 18px 25px;
		font-size: 14px;
		font-weight: 650;
		text-decoration: none;
		border-radius: 4px;
	}
	.bottom {
		padding: 35px 0;
		display: flex;
		justify-content: space-between;
		gap: 20px;
		align-items: center;
		font-size: 12px;
		border-top: 1px solid var(--line);
	}
	.bottom nav {
		display: flex;
		gap: 20px;
	}
	.section-heading {
		font-size: clamp(32px, 4vw, 52px);
		letter-spacing: -0.04em;
		font-weight: 550;
		line-height: 1.1;
	}
	.card-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 25px;
	}
	.card-grid h3 {
		font-size: 22px;
		font-weight: 600;
		letter-spacing: -0.025em;
	}
	.card-grid p {
		font-size: 14px;
	}
	.icon svg {
		width: 16px;
		height: 16px;
		fill: currentColor;
	}
	details summary {
		cursor: pointer;
		padding: 20px 0;
		font-size: 16px;
	}
	details {
		border-top: 1px solid var(--line);
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 13px;
	}
	th,
	td {
		text-align: left;
		padding: 15px;
		border-bottom: 1px solid var(--line);
		overflow-wrap: anywhere;
	}
	th {
		font-weight: 600;
	}
	main > section {
		margin-bottom: 100px;
	}
	.source-label {
		font: 10px var(--mono);
		letter-spacing: 0.06em;
	}
	a:focus-visible,
	summary:focus-visible {
		outline: 3px solid currentColor;
		outline-offset: 5px;
	}
	@media (max-width: 900px) {
		.card-grid {
			grid-template-columns: 1fr;
		}
		main > section {
			margin-bottom: 70px;
		}
	}
	@media (max-width: 600px) {
		.folio {
			width: calc(100% - 36px);
		}
		.topbar {
			min-height: 85px;
			gap: 16px;
			flex-wrap: wrap;
			padding: 20px 0;
		}
		.topbar nav {
			gap: 16px;
			font-size: 11px;
		}
		.wordmark {
			font-size: 21px;
		}
		.bottom {
			flex-wrap: wrap;
		}
		.cta {
			padding: 16px 20px;
		}
		th,
		td {
			padding: 12px 7px;
			font-size: 11px;
		}
		main > section {
			margin-bottom: 55px;
		}
	}
	.host-cover {
		padding-top: 40px;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 70px;
		align-items: center;
	}
	.host-title h1 {
		font-size: clamp(51px, 5.4vw, 76px);
		line-height: 1.06;
		letter-spacing: -0.055em;
		font-weight: 550;
		margin: 30px 0;
	}
	.host-title h1 em {
		font-style: normal;
		color: #7fc6c6;
	}
	.host-title > p:last-of-type {
		font-size: 18px;
		color: #9cb3ba;
		max-width: 420px;
	}
	.tag {
		color: #7fc6c6;
	}
	.cta {
		background: #b5ded4;
		color: #10262b;
	}
	.host-actions {
		display: flex;
		flex-direction: column;
		align-items: start;
		gap: 22px;
		margin-top: 28px;
	}
	.host-actions > span {
		font: 9px var(--mono);
		color: #94adb4;
	}
	.topology {
		border: 1px solid #415962;
		background-color: #142730;
		background-image: radial-gradient(#69859030 1px, transparent 1px);
		background-size: 16px 16px;
		border-radius: 8px;
		padding: 28px;
	}
	.topology-title {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		color: #8fafb7;
		font: 9px var(--mono);
		margin-bottom: 30px;
	}
	.operator,
	.host-box-title {
		display: flex;
		align-items: center;
		gap: 18px;
	}
	.operator {
		background: #1a3540;
		border: 1px solid #42616b;
		padding: 20px;
		border-radius: 5px;
	}
	.node-icon {
		font-size: 30px;
		color: #95d0c9;
	}
	.operator strong,
	.host-box-title strong {
		font-size: 16px;
		font-weight: 550;
	}
	.operator small,
	.host-box-title small {
		display: block;
		color: #88a6b0;
		font-size: 10px;
		margin-top: 8px;
		line-height: 1.5;
	}
	.ssh-link {
		display: flex;
		flex-direction: column;
		align-items: center;
		font: 9px var(--mono);
		color: #95d0c9;
		gap: 8px;
	}
	.ssh-link i {
		height: 25px;
		width: 1px;
		background: #78aca9;
	}
	.host-box {
		border: 1px solid #507775;
		border-radius: 5px;
		background: #183139;
		padding: 22px;
	}
	.app-nodes {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 9px;
		margin-top: 25px;
	}
	.app-nodes > div {
		border: 1px solid #456663;
		border-radius: 4px;
		padding: 15px 10px;
		background: #294647;
	}
	.app-nodes span {
		display: block;
		font: 8px var(--mono);
		color: #8ab4b0;
		margin-bottom: 20px;
	}
	.app-nodes b {
		display: block;
		font: 16px var(--mono);
		font-weight: 500;
		margin-bottom: 15px;
	}
	.app-nodes small {
		font: 7px var(--mono);
		color: #a0bfbc;
		white-space: nowrap;
	}
	.host-signals {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		color: #89b0b2;
		font: 8px var(--mono);
		margin-top: 25px;
		border-top: 1px solid #365d60;
		padding-top: 18px;
	}
	.topology-caption {
		font-size: 11px;
		color: #8fafb7;
		line-height: 1.6;
		margin-top: 22px;
	}
	.operations {
		display: grid;
		grid-template-columns: 1fr 1.3fr;
		gap: 90px;
	}
	.operations > div > p:last-child {
		font-size: 16px;
		color: #9cb3ba;
		max-width: 360px;
	}
	.operation-list article {
		display: flex;
		align-items: start;
		gap: 25px;
		border-top: 1px solid var(--line);
		padding: 25px 0;
	}
	.operation-list article > span {
		font: 11px var(--mono);
		color: #7fc6c6;
		padding-top: 7px;
	}
	.operation-list h3 {
		font-size: 24px;
		letter-spacing: -0.03em;
		font-weight: 550;
		margin: 0 0 12px;
	}
	.operation-list p {
		font-size: 14px;
		color: #9cb3ba;
		margin: 0;
	}
	.operation-list a {
		font-size: 12px;
		display: inline-block;
		margin-top: 15px;
		color: #b5ded4;
	}
	.operation-list code {
		font-size: 12px;
		color: #d3e5e5;
	}
	.command-rail {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 20px;
		background: #203941;
		padding: 30px;
		border: 1px solid #42616b;
		border-radius: 5px;
	}
	.command-rail > span {
		font: 9px var(--mono);
		color: #8fafb7;
	}
	.command-rail > code {
		font-size: 14px;
		padding: 12px 15px;
		background: #101e25;
		border: 1px solid #415962;
	}
	.command-rail p {
		font-size: 10px;
		color: #8fafb7;
	}
	.host-start {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 90px;
		background: #b5ded4;
		color: #163039;
		padding: 45px;
		border-radius: 7px;
	}
	.host-start .tag {
		color: #406a6b;
	}
	.host-start a {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 22px 0;
		border-bottom: 1px solid #91b8ad;
		text-decoration: none;
	}
	.host-start b {
		font-size: 20px;
		font-weight: 550;
	}
	.host-start a span {
		font-size: 11px;
		color: #406a6b;
	}
	@media (max-width: 900px) {
		.host-cover {
			gap: 30px;
		}
		.topology {
			padding: 20px;
		}
		.app-nodes b {
			font-size: 13px;
		}
		.operations,
		.host-start {
			gap: 40px;
		}
		.app-nodes small {
			font-size: 6px;
		}
	}
	@media (max-width: 600px) {
		.host-cover,
		.operations,
		.host-start {
			grid-template-columns: 1fr;
			gap: 35px;
		}
		.host-cover {
			padding-top: 20px;
		}
		.host-title h1 {
			font-size: 53px;
		}
		.host-title > p:last-of-type {
			font-size: 16px;
		}
		.topology {
			padding: 18px;
		}
		.topology-title {
			font-size: 8px;
		}
		.host-box {
			padding: 16px;
		}
		.app-nodes {
			gap: 7px;
		}
		.host-start {
			padding: 30px 24px;
		}
		.command-rail {
			padding: 24px;
			gap: 13px;
		}
		.command-rail > span {
			width: 100%;
		}
		.command-rail > code {
			font-size: 12px;
		}
		.operation-list article {
			gap: 18px;
		}
	}
</style>
